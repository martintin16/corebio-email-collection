# Project Settings → API en tu proyecto de Supabase.
# NEXT_PUBLIC_* porque el cliente del navegador (lib/supabase/client.ts) los
# necesita para el login — son públicos por diseño, no son secretos (la
# seguridad real de Supabase corre por Row Level Security, no por ocultar
# estas dos claves).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL del backend (NestJS). En local: http://localhost:4000. En producción, la
# de Railway. NEXT_PUBLIC_ porque el navegador también la usa para enviar y
# descargar adjuntos (van directo al backend; ver lib/api/http.browser.ts).
NEXT_PUBLIC_API_URL=http://localhost:4000
